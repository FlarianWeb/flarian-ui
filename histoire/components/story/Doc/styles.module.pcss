.card {
	display: block;
	width: 100%;
}

.pre {
	overflow-x: auto;
	display: block;
	box-sizing: border-box;
	width: 100%;
	margin: 0;
	padding: 0.75rem 1rem;
	background: var(--ui-color-bg-extra);
	border: 1px solid var(--ui-color-border-muted);
	border-radius: 6px;
}

.code {
	font-family: monospace;
	font-size: 0.8rem;
	line-height: 1.7;
	color: var(--ui-color-fg);
	white-space: pre;
	background: none !important;
}
