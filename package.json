{
	"name": "@flarian/ui",
	"version": "0.0.0-development",
	"description": "Vue 3 UI kit with themes, design tokens and a bundler plugin",
	"license": "MIT",
	"author": "FlarianWeb",
	"keywords": [
		"vue",
		"ui-kit",
		"design-system",
		"design-tokens",
		"nuxt",
		"unplugin"
	],
	"homepage": "https://github.com/FlarianWeb/flarian-ui#readme",
	"bugs": "https://github.com/FlarianWeb/flarian-ui/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/FlarianWeb/flarian-ui.git"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"type": "module",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.es.js"
		},
		"./runtime": {
			"types": "./dist/runtime/index.d.ts",
			"import": "./dist/runtime.es.js"
		},
		"./vite": {
			"types": "./dist/plugin/vite.d.ts",
			"import": "./dist/vite.es.js"
		},
		"./rollup": {
			"types": "./dist/plugin/rollup.d.ts",
			"import": "./dist/rollup.es.js"
		},
		"./webpack": {
			"types": "./dist/plugin/webpack.d.ts",
			"import": "./dist/webpack.es.js"
		},
		"./rspack": {
			"types": "./dist/plugin/rspack.d.ts",
			"import": "./dist/rspack.es.js"
		},
		"./esbuild": {
			"types": "./dist/plugin/esbuild.d.ts",
			"import": "./dist/esbuild.es.js"
		},
		"./nuxt": {
			"types": "./dist/nuxt/index.d.ts",
			"import": "./dist/nuxt.es.js"
		},
		"./inject": "./dist/flarian-ui.inject.js",
		"./styles": "./dist/styles.css",
		"./theme.css": "./dist/theme.css",
		"./package.json": "./package.json"
	},
	"sideEffects": [
		"**/*.css",
		"./dist/flarian-ui.inject.js",
		"./src/flarian-ui.inject.ts"
	],
	"engines": {
		"node": ">=22.18.0"
	},
	"scripts": {
		"build": "vite build && vue-tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && vite build --config vite.config.cdn.ts",
		"prepack": "pnpm build",
		"preview": "vite preview",
		"test": "vitest run --typecheck",
		"test:unit": "vitest --typecheck",
		"test:coverage": "vitest run --coverage",
		"test:coverage-ci": "vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=cobertura",
		"scaffold": "node scripts/scaffold-component.ts",
		"typecheck": "vue-tsc --noEmit",
		"lint": "eslint . --max-warnings 0 && stylelint \"**/*.{pcss,vue}\" --max-warnings 0",
		"lint:fix": "eslint . --fix && stylelint \"**/*.{pcss,vue}\" --fix",
		"story:dev": "histoire dev",
		"story:build": "HISTOIRE=true histoire build",
		"story:preview": "histoire preview"
	},
	"dependencies": {
		"unplugin": "3.3.0"
	},
	"devDependencies": {
		"@flarian/frontend-preset": "3.0.0",
		"@flarian/language-plugin-css-modules": "1.0.0",
		"@fontsource-variable/inter": "5.3.0",
		"@histoire/controls": "1.0.0-beta.1",
		"@histoire/plugin-vue": "1.0.0-beta.1",
		"@nuxt/kit": "4.4.8",
		"@nuxt/schema": "4.4.8",
		"@types/node": "24.13.3",
		"@vitejs/plugin-vue": "6.0.8",
		"@vitest/coverage-v8": "4.1.11",
		"@vue/language-plugin-pug": "3.3.11",
		"@vue/test-utils": "2.4.11",
		"@vue/tsconfig": "0.9.1",
		"conventional-changelog-conventionalcommits": "9.3.1",
		"eslint": "10.10.0",
		"highlight.js": "11.11.1",
		"histoire": "1.0.0-beta.1",
		"jsdom": "29.1.1",
		"postcss": "8.5.28",
		"postcss-nested": "7.0.2",
		"prettier": "3.9.6",
		"pug": "3.0.4",
		"semantic-release": "25.0.9",
		"stylelint": "17.15.0",
		"tsc-alias": "1.9.1",
		"typescript": "6.0.3",
		"unplugin-auto-import": "21.0.0",
		"unplugin-vue-components": "32.1.0",
		"vite": "8.1.5",
		"vite-plugin-pug": "0.4.1",
		"vitest": "4.1.11",
		"vue": "3.5.40",
		"vue-tsc": "3.3.11"
	},
	"peerDependencies": {
		"@nuxt/kit": "^4.0.0",
		"vite": "^8.0.0",
		"vue": "^3.5.0"
	},
	"peerDependenciesMeta": {
		"@nuxt/kit": {
			"optional": true
		},
		"vite": {
			"optional": true
		}
	},
	"packageManager": "pnpm@12.4.1"
}
